menuconfig COPRO_STREAM_CLIENT
    bool "Coprocessor stream Client"
    default y
    depends on USB_DEVICE_NETWORK_ECM
    help
      This option allows you to configure the Stream Client settings.

if COPRO_STREAM_CLIENT

config COPRO_STREAM_PORT
    int "Stream Port"
    default 4000
    help
      The port number to use for the Stream Client.

config COPRO_STREAM_HOST
    string "Stream Host"
    default "192.0.3.1"
    help
      The host to connect to for the Stream Client.

config COPRO_STREAM_TRY_CONNECT_INTERVAL
    int "Stream Try Connect Interval"
    default 1000
    help
      The interval in milliseconds to try to connect to the Stream Client.

config COPRO_STREAM_CHANNELS_COUNT
    int "Stream Channels Count"
    default 2 if COPRO_XIAOMI_LYWSD03MMC && COPRO_LINKY_TIC
    default 1
    help
      The number of channels to use for the Streams.

config COPRO_STREAM_CHANNEL_MSG_MAX_SIZE
    int "Stream Channel (SC) Message Max Size"
    default 128
    help
      The maximum size of the message to send to the Stream Client.

config COPRO_STREAM_CHANNEL_RX
    bool "Enable RX (server-to-device) channel support"
    default n
    help
      When enabled, a dedicated RX thread is started. It reads incoming
      frames from the server and dispatches each payload to the rx_msgq
      of the matching channel (if one was registered). Disable this to
      reduce flash and RAM when bidirectional communication is not needed.

endif # COPRO_STREAM_CLIENT

menuconfig COPRO_DEVICE_CONTROL
    bool "Device Control channel"
    default n
    depends on COPRO_STREAM_CLIENT
    select COPRO_STREAM_CHANNEL_RX
    help
      Enables the device-control stream channel.  Commands (e.g. open
      garage door) are sent from the device to the server, and state
      updates (e.g. garage-door positions) are received from the server.

if COPRO_DEVICE_CONTROL

config COPRO_DEVICE_CONTROL_CMD_QUEUE_SIZE
    int "Command queue size"
    default 8
    help
      Number of outgoing command messages that can be buffered before the
      TX thread drains them.

config COPRO_DEVICE_CONTROL_STATE_QUEUE_SIZE
    int "State queue size"
    default 8
    help
      Number of incoming state messages that can be buffered before the
      application reads them.

endif # COPRO_DEVICE_CONTROL


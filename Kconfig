    int "Configuration Port"
    default 4001
    help
      The port number to use for the Configuration Server.

endif # COPRO_CONFIG_SERVER

menuconfig COPRO_BLE_SERVER
    bool "Coprocessor BLE Server"
    default n
    help
      This option allows you to expose services from the coprocessor as a BLE server.

if COPRO_BLE_SERVER

config COPRO_BLE_IDLE_TIMEOUT_S
    int "BLE idle connection timeout (seconds)"
    default 30
    help
      Disconnect a BLE connection that has been idle for this many seconds.
      Idle means no authenticated GATT write or security-level upgrade has
      been received. Set to 0 to disable the timeout entirely.

endif # COPRO_BLE_SERVER

